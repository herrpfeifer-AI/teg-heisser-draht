{
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/lehrer", "destination": "/index.html" },
    { "source": "/einfach", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
